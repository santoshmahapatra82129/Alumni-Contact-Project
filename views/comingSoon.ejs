<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title><%= title %> | IGIT Connect</title>
  <%- include('partials/theme-head') %>
  <style>
    .cs-card {
      max-width: 600px;
      margin: 60px auto;
      padding: 60px 40px;
      text-align: center;
      animation: fadeInUp 0.6s ease;
    }
    .cs-icon { font-size: 5rem; margin-bottom: 20px; }
    .cs-card h2 {
      font-size: 2rem;
      background: linear-gradient(135deg, #fff, #b8c5ff);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      margin-bottom: 12px;
    }
    .cs-badge {
      display: inline-block;
      background: rgba(102, 126, 234, 0.15);
      color: #b8c5ff;
      padding: 6px 18px;
      border-radius: 20px;
      font-size: 0.85rem;
      font-weight: bold;
      border: 1px solid rgba(102, 126, 234, 0.3);
      margin-bottom: 20px;
    }
    .cs-card p { color: #94a3b8; line-height: 1.7; margin-bottom: 28px; }
  </style>
</head>
<body>

<%- include('partials/theme-bg') %>

<div class="topbar">
  <a href="/landing" class="logo">🎓 IGIT Connect</a>
  <a href="/resources" class="back">← Back to Resources</a>
</div>

<div class="page-container">
  <div class="glass-card cs-card">
    <div class="cs-icon"><%= icon %></div>
    <span class="cs-badge">Coming Soon</span>
    <h2><%= title %></h2>
    <p><%= description %></p>
    <a href="/resources" class="btn-primary">← Browse Other Resources</a>
  </div>
</div>

</body>
</html>

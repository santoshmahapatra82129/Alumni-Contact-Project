<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>IGIT Alumni Connect — Bridge Between Students & Alumni</title>
  <link rel="stylesheet" href="/css/theme.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #0a0e27;
      color: #e8eaf6;
      overflow-x: hidden;
    }

    /* ============ NAVBAR ============ */
    nav {
      position: fixed;
      top: 0; left: 0; right: 0;
      padding: 18px 50px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 100;
      background: rgba(10, 14, 39, 0.7);
      backdrop-filter: blur(15px);
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .logo {
      font-size: 1.4rem;
      font-weight: bold;
      background: linear-gradient(90deg, #667eea, #f093fb);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .nav-links { display: flex; gap: 30px; align-items: center; }
    .nav-links a {
      color: #cbd5e1;
      text-decoration: none;
      font-size: 0.95rem;
      transition: color 0.3s;
    }
    .nav-links a:hover { color: #fff; }
    .nav-btn {
      padding: 9px 22px;
      border-radius: 25px;
      font-weight: bold;
      transition: all 0.3s;
    }
    .nav-btn.outline {
      border: 1.5px solid #667eea;
      color: #667eea !important;
    }
    .nav-btn.outline:hover {
      background: #667eea;
      color: #fff !important;
    }
    .nav-btn.solid {
      background: linear-gradient(135deg, #667eea, #764ba2);
      color: #fff !important;
    }
    .nav-btn.solid:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
    }

    /* ============ HERO ============ */
    .hero {
      position: relative;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: hidden;
    }
    /* ===== Global fixed 3D world (single scene, scroll-scrubbed camera) ===== */
    #three-canvas {
      position: fixed;
      top: 0; left: 0;
      width: 100vw; height: 100vh;
      z-index: 1;
      pointer-events: none;
    }
    /* every content layer above the 3D world */
    nav, .hero, section, footer, .scroll-progress { position: relative; z-index: 3; }
    /* let the 3D world breathe through every section */
    section { background: transparent !important; }
    .stats { background: linear-gradient(180deg, rgba(10,14,39,0) 0%, rgba(13,19,48,0.55) 50%, rgba(10,14,39,0) 100%) !important; }
    #how, #about { background: linear-gradient(180deg, rgba(255,255,255,0.02), rgba(255,255,255,0)) !important; }

    /* ===== Top scroll-progress bar ===== */
    .scroll-progress {
      position: fixed; top: 0; left: 0;
      height: 3px; width: 0%;
      background: linear-gradient(90deg, #667eea, #f093fb);
      box-shadow: 0 0 15px rgba(102,126,234,.7);
      z-index: 200;
      transition: width 0.05s linear;
    }

    /* ===== SaaS-style reveal primitives (initial state; GSAP animates them) ===== */
    .reveal      { opacity: 0; transform: translateY(40px); will-change: transform, opacity; }
    .reveal-stagger > *  { opacity: 0; transform: translateY(40px); will-change: transform, opacity; }
    .reveal-scale { opacity: 0; transform: scale(0.92); will-change: transform, opacity; }

    /* ===== Glass card upgrade for premium feel ===== */
    .feature-card, .testimonial, .stat-card, .step {
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
    }
    .hero-content {
      position: relative;
      z-index: 2;
      text-align: center;
      padding: 0 20px;
      max-width: 900px;
    }
    .hero-badge {
      display: inline-block;
      background: rgba(102, 126, 234, 0.15);
      border: 1px solid rgba(102, 126, 234, 0.4);
      padding: 6px 18px;
      border-radius: 25px;
      font-size: 0.85rem;
      color: #b8c5ff;
      margin-bottom: 25px;
      animation: fadeInUp 0.8s ease;
    }
    .hero h1 {
      font-size: 4rem;
      line-height: 1.1;
      margin-bottom: 25px;
      background: linear-gradient(135deg, #fff 0%, #b8c5ff 50%, #f093fb 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: fadeInUp 1s ease;
    }
    .hero p {
      font-size: 1.25rem;
      color: #a0aec0;
      margin-bottom: 40px;
      animation: fadeInUp 1.2s ease;
    }
    .hero-cta { display: flex; gap: 18px; justify-content: center; flex-wrap: wrap; animation: fadeInUp 1.4s ease; }
    .cta-primary, .cta-secondary {
      padding: 14px 35px;
      border-radius: 30px;
      font-size: 1rem;
      font-weight: bold;
      text-decoration: none;
      transition: all 0.3s;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .cta-primary {
      background: linear-gradient(135deg, #667eea, #764ba2);
      color: #fff;
      box-shadow: 0 10px 30px rgba(102, 126, 234, 0.4);
    }
    .cta-primary:hover {
      transform: translateY(-3px);
      box-shadow: 0 15px 40px rgba(102, 126, 234, 0.6);
    }
    .cta-secondary {
      border: 1.5px solid rgba(255,255,255,0.3);
      color: #fff;
      backdrop-filter: blur(10px);
    }
    .cta-secondary:hover {
      background: rgba(255,255,255,0.1);
      transform: translateY(-3px);
    }
    .scroll-indicator {
      position: absolute;
      bottom: 30px;
      left: 50%;
      transform: translateX(-50%);
      color: rgba(255,255,255,0.5);
      animation: bounce 2s infinite;
      z-index: 2;
    }
    @keyframes bounce {
      0%, 100% { transform: translateX(-50%) translateY(0); }
      50% { transform: translateX(-50%) translateY(10px); }
    }
    @keyframes fadeInUp {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ============ SECTIONS ============ */
    section { padding: 100px 50px; position: relative; }
    .section-title {
      text-align: center;
      font-size: 2.5rem;
      margin-bottom: 15px;
      background: linear-gradient(90deg, #667eea, #f093fb);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .section-subtitle {
      text-align: center;
      color: #94a3b8;
      max-width: 700px;
      margin: 0 auto 60px;
      font-size: 1.05rem;
    }

    /* ============ STATS ============ */
    .stats {
      background: linear-gradient(135deg, rgba(102, 126, 234, 0.08), rgba(118, 75, 162, 0.08));
      border-top: 1px solid rgba(255,255,255,0.05);
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .stats-grid {
      max-width: 1100px;
      margin: auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 30px;
      text-align: center;
    }
    .stat-num {
      font-size: 3rem;
      font-weight: bold;
      background: linear-gradient(135deg, #667eea, #f093fb);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .stat-label { color: #94a3b8; margin-top: 8px; }

    /* ============ FEATURES ============ */
    .features-grid {
      max-width: 1200px;
      margin: auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 25px;
    }
    .feature-card {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      padding: 35px 28px;
      border-radius: 16px;
      transition: all 0.4s;
      position: relative;
      overflow: hidden;
    }
    .feature-card::before {
      content: '';
      position: absolute;
      top: 0; left: -100%;
      width: 100%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(102, 126, 234, 0.1), transparent);
      transition: left 0.6s;
    }
    .feature-card:hover::before { left: 100%; }
    .feature-card:hover {
      transform: translateY(-6px);
      border-color: rgba(102, 126, 234, 0.5);
      box-shadow: 0 15px 40px rgba(102, 126, 234, 0.2);
    }
    .feature-icon {
      font-size: 2.5rem;
      margin-bottom: 18px;
      display: inline-block;
    }
    .feature-card h3 { color: #fff; margin-bottom: 12px; font-size: 1.25rem; }
    .feature-card p { color: #94a3b8; font-size: 0.95rem; line-height: 1.6; }

    /* ============ HOW IT WORKS ============ */
    .how-grid {
      max-width: 1100px;
      margin: auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 25px;
    }
    .step {
      text-align: center;
      padding: 25px;
    }
    .step-num {
      width: 60px; height: 60px;
      margin: 0 auto 18px;
      background: linear-gradient(135deg, #667eea, #764ba2);
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      font-weight: bold;
      color: #fff;
      box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
    }
    .step h4 { color: #fff; margin-bottom: 8px; }
    .step p { color: #94a3b8; font-size: 0.9rem; }

    /* ============ TESTIMONIALS ============ */
    .testimonials-grid {
      max-width: 1100px;
      margin: auto;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 25px;
    }
    .testimonial {
      background: rgba(255,255,255,0.03);
      border: 1px solid rgba(255,255,255,0.08);
      padding: 28px;
      border-radius: 14px;
      position: relative;
    }
    .testimonial::before {
      content: '"';
      position: absolute;
      top: -10px; left: 18px;
      font-size: 4rem;
      color: rgba(102, 126, 234, 0.3);
      font-family: serif;
    }
    .testimonial p { color: #cbd5e1; font-style: italic; margin-bottom: 20px; line-height: 1.6; }
    .testimonial-author { display: flex; align-items: center; gap: 12px; }
    .avatar {
      width: 45px; height: 45px;
      border-radius: 50%;
      background: linear-gradient(135deg, #667eea, #f093fb);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      color: #fff;
    }
    .author-info strong { color: #fff; display: block; font-size: 0.95rem; }
    .author-info span { color: #94a3b8; font-size: 0.8rem; }

    /* ============ ABOUT ============ */
    .about-content {
      max-width: 1000px;
      margin: auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 60px;
      align-items: center;
    }
    .about-text p { color: #cbd5e1; line-height: 1.8; margin-bottom: 18px; }
    .about-image {
      background: linear-gradient(135deg, rgba(102, 126, 234, 0.2), rgba(118, 75, 162, 0.2));
      border-radius: 16px;
      padding: 18px;
      text-align: center;
      border: 1px solid rgba(255,255,255,0.08);
      overflow: hidden;
    }
    .about-image img.campus {
      width: 100%;
      height: 240px;
      object-fit: cover;
      border-radius: 12px;
      display: block;
      box-shadow: 0 10px 30px rgba(0,0,0,0.35);
    }

    /* ============ CTA SECTION ============ */
    .final-cta {
      text-align: center;
      background: linear-gradient(135deg, rgba(102, 126, 234, 0.15), rgba(240, 147, 251, 0.15));
      padding: 80px 30px;
      border-radius: 24px;
      max-width: 900px;
      margin: 50px auto;
      border: 1px solid rgba(255,255,255,0.08);
    }
    .final-cta h2 { font-size: 2.2rem; color: #fff; margin-bottom: 15px; }
    .final-cta p { color: #cbd5e1; margin-bottom: 30px; }

    /* ============ FOOTER ============ */
    footer {
      background: #060920;
      padding: 60px 50px 25px;
      border-top: 1px solid rgba(255,255,255,0.05);
    }
    .footer-grid {
      max-width: 1200px;
      margin: auto;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 40px;
      margin-bottom: 35px;
    }
    .footer-col h4 { color: #fff; margin-bottom: 18px; font-size: 1rem; }
    .footer-col p, .footer-col a {
      color: #94a3b8;
      font-size: 0.9rem;
      margin-bottom: 8px;
      display: block;
      text-decoration: none;
      line-height: 1.6;
    }
    .footer-col a:hover { color: #667eea; }
    .footer-bottom {
      border-top: 1px solid rgba(255,255,255,0.05);
      padding-top: 20px;
      text-align: center;
      color: #64748b;
      font-size: 0.85rem;
    }

    @media (max-width: 768px) {
      nav { padding: 14px 20px; }
      .nav-links a:not(.nav-btn) { display: none; }
      .hero h1 { font-size: 2.5rem; }
      section { padding: 60px 20px; }
      .about-content { grid-template-columns: 1fr; }
      .footer-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>

<!-- ====================================================================
     LANDING PAGE — SaaS-grade scroll-driven 3D + reveal animations
     ==================================================================== -->
<script>
(function () {
  gsap.registerPlugin(ScrollTrigger);

  // ---------- THREE.JS WORLD ----------
  const canvas = document.getElementById('three-canvas');
  const scene = new THREE.Scene();
  scene.fog = new THREE.FogExp2(0x0a0e27, 0.022);
  const camera = new THREE.PerspectiveCamera(70, window.innerWidth / window.innerHeight, 0.1, 200);
  camera.position.set(0, 0, 8);
  const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(window.innerWidth, window.innerHeight);

  const TAU = Math.PI * 2;
  const wireMat = (c, op = 0.55) => new THREE.MeshBasicMaterial({ color: c, wireframe: true, transparent: true, opacity: op });

  // ---------- BACKDROP STARFIELD ----------
  let starfield;
  (() => {
    const N = 1500;
    const pos = new Float32Array(N * 3), col = new Float32Array(N * 3);
    for (let i = 0; i < N; i++) {
      pos[i*3]   = (Math.random() - 0.5) * 120;
      pos[i*3+1] = (Math.random() - 0.5) * 80;
      pos[i*3+2] = (Math.random() - 0.5) * 100;
      const m = Math.random();
      col[i*3]=0.5+m*0.5; col[i*3+1]=0.55+m*0.4; col[i*3+2]=0.95;
    }
    const g = new THREE.BufferGeometry();
    g.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    g.setAttribute('color', new THREE.BufferAttribute(col, 3));
    starfield = new THREE.Points(g, new THREE.PointsMaterial({ size: 0.06, vertexColors: true, transparent: true, opacity: 0.85 }));
    scene.add(starfield);
  })();

  // ---------- STAGES ----------
  const stages = [];
  const STEP = 30;
  function add(stage) { stage.group.position.set(stage.x, 0, 0); scene.add(stage.group); stages.push(stage); }

  // 0) HERO
  (() => {
    const g = new THREE.Group();
    const sphere = new THREE.Mesh(new THREE.SphereGeometry(2.5, 32, 32), wireMat(0x667eea, 0.45));
    const inner  = new THREE.Mesh(new THREE.SphereGeometry(1.7, 16, 16), wireMat(0xf093fb, 0.30));
    g.add(sphere); g.add(inner);
    const rings = new THREE.Group();
    for (let i = 0; i < 3; i++) {
      const t = new THREE.Mesh(new THREE.TorusGeometry(3.5 + i * 0.7, 0.025, 8, 80),
        new THREE.MeshBasicMaterial({ color: i % 2 ? 0xf093fb : 0x667eea, transparent: true, opacity: 0.45 }));
      t.rotation.x = Math.random() * Math.PI; t.rotation.y = Math.random() * Math.PI;
      rings.add(t);
    }
    g.add(rings);
    add({ key:'hero', group:g, x:0, tick(t){
      sphere.rotation.x += 0.002; sphere.rotation.y += 0.003;
      inner.rotation.x  -= 0.004; inner.rotation.y  -= 0.003;
      rings.rotation.x += 0.001; rings.rotation.y += 0.002;
      rings.children.forEach((r, i) => { r.rotation.z += 0.005 * (i + 1); });
    }});
  })();

  // 1) STATS — 3x3 icosahedra
  (() => {
    const g = new THREE.Group();
    const mat = wireMat(0x667eea, 0.5);
    const cells = [];
    for (let x = -1; x <= 1; x++) for (let y = -1; y <= 1; y++) {
      const m = new THREE.Mesh(new THREE.IcosahedronGeometry(0.85, 0), mat);
      m.position.set(x * 2.4, y * 1.7, 0);
      g.add(m); cells.push(m);
    }
    add({ key:'stats', group:g, x:STEP*1, tick(t){
      g.rotation.y = t * 0.0003;
      cells.forEach((m, i) => { m.rotation.x = t * 0.0008 + i; m.rotation.y = t * 0.0011 + i; });
    }});
  })();

  // 2) FEATURES — orbiting platonic solids
  (() => {
    const g = new THREE.Group();
    const palette = [0x667eea, 0xf093fb, 0x764ba2, 0x4fd1c5, 0xfbbf24, 0xec4899];
    const geoms = [
      new THREE.BoxGeometry(1.3,1.3,1.3),
      new THREE.TetrahedronGeometry(1.1),
      new THREE.OctahedronGeometry(1.1),
      new THREE.TorusKnotGeometry(0.7, 0.22, 64, 8),
      new THREE.DodecahedronGeometry(1),
      new THREE.TorusGeometry(0.95, 0.22, 8, 32),
    ];
    const meshes = [];
    geoms.forEach((geo, i) => {
      const m = new THREE.Mesh(geo, wireMat(palette[i], 0.6));
      m.userData.a = (i / geoms.length) * TAU; m.userData.r = 4.8;
      g.add(m); meshes.push(m);
    });
    add({ key:'features', group:g, x:STEP*2, tick(t){
      meshes.forEach((m, i) => {
        const a = m.userData.a + t * 0.00035;
        m.position.x = Math.cos(a) * m.userData.r;
        m.position.z = Math.sin(a) * 1.6;
        m.position.y = Math.sin(a * 1.4 + i) * 1.5;
        m.rotation.x = t * 0.0009 + i; m.rotation.y = t * 0.0012 + i;
      });
    }});
  })();

  // 3) HOW — node network
  (() => {
    const g = new THREE.Group();
    const N = 70, pts = [];
    for (let i = 0; i < N; i++) pts.push(new THREE.Vector3((Math.random()-0.5)*9, (Math.random()-0.5)*5.5, (Math.random()-0.5)*5));
    const pGeo = new THREE.BufferGeometry().setFromPoints(pts);
    const points = new THREE.Points(pGeo, new THREE.PointsMaterial({ color: 0xb8c5ff, size: 0.10, transparent: true, opacity: 0.9 }));
    g.add(points);
    const lp = [];
    for (let i = 0; i < N; i++) for (let j = i+1; j < N; j++)
      if (pts[i].distanceTo(pts[j]) < 2.4) lp.push(pts[i].x, pts[i].y, pts[i].z, pts[j].x, pts[j].y, pts[j].z);
    const lGeo = new THREE.BufferGeometry();
    lGeo.setAttribute('position', new THREE.Float32BufferAttribute(lp, 3));
    g.add(new THREE.LineSegments(lGeo, new THREE.LineBasicMaterial({ color: 0x667eea, transparent: true, opacity: 0.28 })));
    add({ key:'how', group:g, x:STEP*3, tick(t){ g.rotation.y = t * 0.0003; g.rotation.x = Math.sin(t*0.0002)*0.25; }});
  })();

  // 4) TESTIMONIALS — wave plane
  (() => {
    const g = new THREE.Group();
    const geo = new THREE.PlaneGeometry(14, 9, 50, 30);
    const plane = new THREE.Mesh(geo, wireMat(0xf093fb, 0.5));
    plane.rotation.x = -Math.PI / 2.3; plane.position.y = -0.5;
    g.add(plane);
    const base = geo.attributes.position.array.slice();
    add({ key:'testimonials', group:g, x:STEP*4, tick(t){
      const p = geo.attributes.position.array;
      for (let i = 0; i < p.length; i += 3) {
        const x = base[i], y = base[i+1];
        p[i+2] = Math.sin(x * 0.7 + t*0.001) * 0.45 + Math.cos(y * 0.7 + t*0.0013) * 0.45;
      }
      geo.attributes.position.needsUpdate = true;
      plane.rotation.z = Math.sin(t*0.0002) * 0.08;
    }});
  })();

  // 5) ABOUT — globe + crossed rings
  (() => {
    const g = new THREE.Group();
    const globe = new THREE.Mesh(new THREE.SphereGeometry(2, 24, 16), wireMat(0x667eea, 0.55));
    const ringA = new THREE.Mesh(new THREE.TorusGeometry(2.9, 0.04, 8, 80),
      new THREE.MeshBasicMaterial({ color: 0xf093fb, transparent: true, opacity: 0.7 }));
    ringA.rotation.x = Math.PI / 3;
    const ringB = ringA.clone();
    ringB.rotation.x = -Math.PI / 3; ringB.material = ringA.material.clone(); ringB.material.color.setHex(0xb8c5ff);
    g.add(globe); g.add(ringA); g.add(ringB);
    add({ key:'about', group:g, x:STEP*5, tick(t){
      globe.rotation.y = t * 0.0005; globe.rotation.x = t * 0.0002;
      ringA.rotation.z = t * 0.0006; ringB.rotation.z = -t * 0.0008;
    }});
  })();

  // 6) CTA — particle vortex
  (() => {
    const g = new THREE.Group();
    const N = 1200;
    const pos = new Float32Array(N*3), col = new Float32Array(N*3);
    for (let i = 0; i < N; i++) {
      const r = 1 + Math.random() * 4.2;
      const a = Math.random() * TAU;
      pos[i*3] = Math.cos(a)*r; pos[i*3+1] = (Math.random()-0.5)*7; pos[i*3+2] = Math.sin(a)*r;
      const m = Math.random();
      col[i*3]=0.4+m*0.6; col[i*3+1]=0.5+m*0.3; col[i*3+2]=0.95;
    }
    const geo = new THREE.BufferGeometry();
    geo.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    geo.setAttribute('color', new THREE.BufferAttribute(col, 3));
    const points = new THREE.Points(geo, new THREE.PointsMaterial({ size: 0.06, vertexColors: true, transparent: true, opacity: 0.85 }));
    g.add(points);
    add({ key:'cta', group:g, x:STEP*6, tick(t){ points.rotation.y = t * 0.0009; points.rotation.x = Math.sin(t*0.0003)*0.2; }});
  })();

  // ---------- CAMERA SCROLL SCRUB ----------
  const camTarget = { x: 0, y: 0, z: 8 };
  let mouseX = 0, mouseY = 0;
  document.addEventListener('mousemove', (e) => {
    mouseX = (e.clientX / window.innerWidth) * 2 - 1;
    mouseY = -(e.clientY / window.innerHeight) * 2 + 1;
  });

  const scrollState = { p: 0 };
  ScrollTrigger.create({
    trigger: document.body, start: 'top top', end: 'bottom bottom', scrub: 0.6,
    onUpdate: (self) => {
      scrollState.p = self.progress;
      const bar = document.getElementById('scrollProgress');
      if (bar) bar.style.width = (self.progress * 100) + '%';
    },
  });

  function animate(t) {
    requestAnimationFrame(animate);
    const last = stages[stages.length - 1].x;
    const targetX = scrollState.p * last;
    const phase = scrollState.p * (stages.length - 1);
    const seg = phase - Math.floor(phase);
    const dip = Math.sin(seg * Math.PI) * 1.4;

    camTarget.x = targetX + mouseX * 0.4;
    camTarget.y = Math.sin(scrollState.p * Math.PI * 2) * 0.6 + mouseY * 0.3;
    camTarget.z = 8 - dip;

    camera.position.x += (camTarget.x - camera.position.x) * 0.08;
    camera.position.y += (camTarget.y - camera.position.y) * 0.08;
    camera.position.z += (camTarget.z - camera.position.z) * 0.08;

    const focusIndex = Math.round(scrollState.p * (stages.length - 1));
    const focus = stages[Math.max(0, Math.min(stages.length - 1, focusIndex))];
    camera.lookAt(focus.group.position.x, 0, 0);

    if (starfield) starfield.rotation.y = t * 0.00005;
    stages.forEach(s => s.tick(t));
    renderer.render(scene, camera);
  }
  requestAnimationFrame(animate);

  window.addEventListener('resize', () => {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
    ScrollTrigger.refresh();
  });

  // ---------- REVEAL ANIMATIONS ----------
  gsap.utils.toArray('.reveal').forEach(el => {
    gsap.to(el, { opacity: 1, y: 0, duration: 1, ease: 'power3.out',
      scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none reverse' } });
  });
  gsap.utils.toArray('.reveal-stagger').forEach(parent => {
    gsap.to(parent.children, { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', stagger: 0.12,
      scrollTrigger: { trigger: parent, start: 'top 80%', toggleActions: 'play none none reverse' } });
  });
  gsap.utils.toArray('.reveal-scale').forEach(el => {
    gsap.to(el, { opacity: 1, scale: 1, duration: 1.1, ease: 'power3.out',
      scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none reverse' } });
  });

  // ---------- ANIMATED STAT COUNTERS ----------
  document.querySelectorAll('.stat-num').forEach(el => {
    const target = parseInt(el.dataset.count, 10) || 0;
    const obj = { v: 0 };
    gsap.to(obj, { v: target, duration: 1.8, ease: 'power2.out',
      scrollTrigger: { trigger: el, start: 'top 85%', toggleActions: 'play none none reverse' },
      onUpdate: () => { el.textContent = Math.round(obj.v) + (target >= 100 ? '+' : ''); } });
  });
})();
</script>

</body>
</html>

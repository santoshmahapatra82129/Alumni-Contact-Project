<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Resume Templates | IGIT Connect</title>
  <%- include('partials/theme-head') %>
  <style>
    .templates-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 22px;
    }
    .tpl-card {
      padding: 24px;
      display: flex;
      flex-direction: column;
      animation: fadeInUp 0.5s ease backwards;
      transition: all 0.3s;
    }
    .tpl-card:hover {
      transform: translateY(-5px);
      border-color: rgba(102, 126, 234, 0.5);
      box-shadow: 0 15px 35px rgba(102, 126, 234, 0.2);
    }
    .ats-badge {
      display: inline-block;
      background: rgba(46, 213, 115, 0.15);
      color: #6fffaa;
      border: 1px solid rgba(46, 213, 115, 0.4);
      padding: 4px 12px;
      border-radius: 14px;
      font-size: 0.72rem;
      font-weight: bold;
      margin-bottom: 12px;
      align-self: flex-start;
    }
    .tpl-card h3 { color: #fff; font-size: 1.15rem; margin-bottom: 8px; }
    .tpl-desc { color: #94a3b8; font-size: 0.88rem; flex: 1; line-height: 1.5; margin-bottom: 8px; }
    .tpl-best {
      color: #b8c5ff;
      font-size: 0.78rem;
      font-style: italic;
      margin-bottom: 16px;
      padding-top: 10px;
      border-top: 1px solid rgba(255,255,255,0.06);
    }
    .tpl-actions { display: flex; gap: 10px; }
    .tpl-actions .btn-primary, .tpl-actions .btn-outline { flex: 1; padding: 9px 12px; font-size: 0.85rem; text-align: center; }
    .info-tip {
      max-width: 780px;
      margin: 0 auto 30px;
      padding: 14px 22px;
      background: rgba(102, 126, 234, 0.08);
      border: 1px solid rgba(102, 126, 234, 0.25);
      border-radius: 12px;
      color: #b8c5ff;
      font-size: 0.9rem;
      text-align: center;
    }
    .info-tip a { color: #f093fb; text-decoration: none; font-weight: bold; }

    .tpl-card:nth-child(1) { animation-delay: 0.05s; }
    .tpl-card:nth-child(2) { animation-delay: 0.10s; }
    .tpl-card:nth-child(3) { animation-delay: 0.15s; }
    .tpl-card:nth-child(4) { animation-delay: 0.20s; }
    .tpl-card:nth-child(5) { animation-delay: 0.25s; }
    .tpl-card:nth-child(6) { animation-delay: 0.30s; }
    .tpl-card:nth-child(7) { animation-delay: 0.35s; }
    .tpl-card:nth-child(8) { animation-delay: 0.40s; }
    .tpl-card:nth-child(9) { animation-delay: 0.45s; }
    .tpl-card:nth-child(10) { animation-delay: 0.50s; }
  </style>
</head>
<body>

<%- include('partials/theme-bg') %>

<div class="topbar">
  <a href="/landing" class="logo">🎓 IGIT Connect</a>
  <a href="/resources" class="back">← Resources</a>
</div>

<div class="page-container">
  <h1 class="page-title">📄 ATS-Friendly Resume Templates</h1>
  <p class="page-subtitle">10 LaTeX templates designed to pass Applicant Tracking Systems. Copy the code or download .tex directly.</p>

  <div class="info-tip">
    💡 Compile for free at <a href="https://www.overleaf.com" target="_blank">Overleaf</a> — paste the code into a new project, edit, and download PDF.
  </div>

  <div class="templates-grid">
    <% templates.forEach(t => { %>
      <div class="glass-card tpl-card">
        <span class="ats-badge">✓ ATS-Friendly</span>
        <h3><%= t.name %></h3>
        <p class="tpl-desc"><%= t.description %></p>
        <p class="tpl-best">Best for: <%= t.bestFor %></p>
        <div class="tpl-actions">
          <a href="/resources/resume/<%= t.id %>" class="btn-outline">View / Copy</a>
          <a href="/resources/resume/<%= t.id %>/download" class="btn-primary">⬇ .tex</a>
        </div>
      </div>
    <% }) %>
  </div>
</div>

</body>
</html>
